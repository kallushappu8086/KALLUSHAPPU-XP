{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/uploads/(.*)",
      "destination": "http://16.60.129.35:25565/uploads/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "http://16.60.129.35:25565/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}