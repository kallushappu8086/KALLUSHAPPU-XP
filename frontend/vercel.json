{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/uploads/(.*)",
      "destination": "http://oh-03.vexanode.gg:4059/uploads/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "http://oh-03.vexanode.gg:4059/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}